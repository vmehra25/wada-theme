{
  "name": "wada-theme",
  "version": "0.1.0",
  "description": "Turn Sanzo Wada palettes into usable website themes through code, CLI, or MCP.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/vmehra25/wada-theme.git" },
